{
	"schemaVersion": 1,
	"id": "hailwall",
	"version": "${version}",
	"name": "HailWall",
	"description": "Server-side mod whitelist/blacklist for Fabric. On join it checks each player's client mods and kicks the ones that are not allowed (or that are missing a required mod). Install it on both the server and the client.",
	"authors": [
		"HailWall"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/hailwall",
		"sources": "https://github.com/Abaraburu/HailWall",
		"issues": "https://github.com/Abaraburu/HailWall/issues"
	},
	"license": "MIT",
	"icon": "assets/hailwall/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.hailwall.HailWallMod"
		],
		"client": [
			"com.hailwall.client.HailWallClient"
		]
	},
	"mixins": [
		"hailwall.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": ["26.1", "26.1.1", "26.1.2"],
		"java": ">=25",
		"fabric-api": "*"
	}
}
